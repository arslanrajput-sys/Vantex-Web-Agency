# Cloudflare Pages Function secret. Configure this under:
# Workers & Pages > your Pages project > Settings > Variables and Secrets.
# Use a Formspree endpoint or another HTTPS form webhook.
CONTACT_FORM_ENDPOINT=

# Public site URL used in canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.vantexweb.com

# Displayed in structured data and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@vantexweb.com
