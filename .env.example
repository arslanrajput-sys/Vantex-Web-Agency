# Public site URL used in canonical links, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://vantexwebstudio.com

# Cloudflare Worker secret from Resend. Never expose this in the browser.
RESEND_API_KEY=re_xxxxxxxxx

# A verified Resend sender identity for the confirmation email.
RESEND_FROM_EMAIL=VantexWeb Studio <hello@vantexwebstudio.com>
